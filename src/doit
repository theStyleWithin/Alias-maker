def menu_easy(state):
    while True:
        print("\nEasy commands")
        entry = pick_easy(state)
        if not entry:
            return
        print(f"\n{entry['explanation']}")
        print(f"Type any of: " + ", ".join(f'"doit {p}"' for p in entry["phrases"]))
        print(f"Real command: {entry['command']}")
        print("  1) Run it now")
        print("  2) Make my own phrase for it")
        number = choose(2)
        if number == 1:
            run_entry_flow(entry, normalize(entry["phrases"][0]), state)
        elif number == 2:
            add_custom(state, command=entry["command"])


def menu_every(state):
    while True:
        print("\nEvery command on this PC")
        name = pick_program(state)
        if not name:
            return
        program = state.program(name) or {"name": name, "description": "", "package": None, "path": ""}
        print(f"\n{program['name']}: {program['description'] or '(no description)'}")
        if program.get("package"):
            print(f"Comes from the package: {program['package']}")
        print(f"Lives at: {program['path']}")
        print("  1) Make a custom command for it")
        print("  2) Read its manual")
        number = choose(2)
        if number == 1:
            add_custom(state, program=name)
        elif number == 2:
            read_manual(name, state)


def read_manual(name, state):
    if not shutil.which("man"):
        print("Manual pages aren't installed. Install them with: sudo pacman -S man-db man-pages")
        return
    if state.dry_run:
        print(f"[dry run] Would run: man {name}")
        return
    if subprocess.run(["man", name]).returncode != 0:
        print(f"{name} doesn't have a manual installed.")


def menu_custom(state):
    while True:
        print("\nCustom commands")
        print("  1) Make a new one")
        for number, custom in enumerate(state.custom, 2):
            print(f"  {number:>2}) doit {custom['phrase']}  ->  {custom['command']}")
        number = choose(len(state.custom) + 1)
        if number == 0:
            return
        if number == 1:
            add_custom(state)
            continue
        custom = state.custom[number - 2]
        print(f"\ndoit {custom['phrase']}  ->  {custom['command']}")
        print("  1) Run it now")
        print("  2) Remove it")
        action = choose(2)
        if action == 1:
            run_entry_flow(custom_entry(custom, state), normalize(custom["phrase"]), state)
        elif action == 2:
            forget_custom(state, custom["phrase"])


def menu_settings(state):
    settings = state.settings
    while True:
        logging = {True: "on", False: "off", None: "not chosen yet"}[settings["logging"]]
        print("\nSettings")
        print(f"  1) Command log (now {logging}): turn {'off' if settings['logging'] else 'on'}")
        print(f"  2) Yes answer (now {yes_hint(settings)}): 'y' or 'yes'")
        print("  3) Yes answer: only the full word 'yes'")
        print("  4) Yes answer: pick my own word")
        number = choose(4)
        if number == 0:
            return
        if number == 1:
            set_logging(settings, not settings["logging"])
        elif number == 2:
            set_yes_words(settings, ["y", "yes"])
        elif number == 3:
            set_yes_words(settings, ["yes"])
        else:
            word = normalize(ask_or_leave("Type your yes word: "))
            if word and " " not in word:
                set_yes_words(settings, [word])
            else:
                print("Pick a single word.")


# ---------- running a command ----------

def explain_and_confirm(entry, settings):
    print(entry["explanation"])
    if entry.get("source_url"):
        print("\nThis downloads and runs a script from:")
        print(f"   {highlight(entry['source_url'])}")
        print(f"That's the vendor's own official installer, not something changed by {APP}.")
    if entry.get("warning"):
        print(f"\nHeads up: {entry['warning']}")
    print(f"\nReal command: {entry['command']}")
    if not entry.get("confirm"):
        return True
    if not interactive():
        print("This one needs a yes from you, so run it in a terminal.")
        return False
    answer = ask(f"Go ahead? (type {yes_hint(settings)} to continue) ")
    return is_yes(answer, settings)


def run_entry(entry, phrase, state):
    if state.dry_run:
        print(f"[dry run] Would run: {entry['command']}")
        return 0
    try:
        code = subprocess.run(entry["command"], shell=True).returncode
    except KeyboardInterrupt:
        code = 130
    write_log(state.settings, phrase, entry["command"], code)
    if code != 0:
        print(f"\nThat didn't work (exit code {code}).")
    elif entry.get("category", "").startswith("install") and library_path().is_file():
        state._library = scan_library()  # new software: refresh the list quietly
    return code


def run_entry_flow(entry, phrase, state):
    first_run_logging(state.settings)
    if not explain_and_confirm(entry, state.settings):
        print("Okay, not doing it.")
        return 1
    return run_entry(entry, phrase, state)


def handle(text, state):
    """Returns an exit code, or None if the phrase wasn't recognised."""
    norm = normalize(text)
    builtin = match_builtin(norm)
    if builtin:
        return run_builtin(*builtin, state)
    custom = state.custom_map.get(norm)
    entry = custom_entry(custom, state) if custom else state.phrase_map.get(norm)
    if entry is None:
        print(f"I don't know how to \"{text.strip()}\" yet.")
        known = list(state.custom_map) + list(state.phrase_map)
        guesses = difflib.get_close_matches(norm, known, n=3, cutoff=0.6)
        if guesses:
            print("Did you mean: " + ", ".join(f'"{g}"' for g in guesses) + "?")
        else:
            print("Type 'doit menu' to see everything, or 'doit search <words>' to find a program.")
        return None
    return run_entry_flow(entry, norm, state)


def main(argv):
    dry_run = "--dry-run" in argv or os.environ.get("DOIT_DRY_RUN") == "1"
    args = [a for a in argv if a != "--dry-run"]
    if args and args[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if args and args[0] == "--version":
        print(f"{APP} {VERSION}")
        return 0

    migrate_old_dirs()
    try:
        commands, phrase_map = load_index(find_index())
    except (OSError, ValueError, KeyError) as err:
        print(f"{APP} couldn't load its command list: {err}", file=sys.stderr)
        return 2
    state = State(commands, phrase_map, load_settings(), dry_run)

    if args:
        code = handle(" ".join(args), state)
        return 1 if code is None else code

    if not interactive():
        print(__doc__.strip())
        return 2
    while True:
        text = ask("Do what? I am waiting... ")
        if text is None:
            print("\nOkay, never mind.")
            return 0
        norm = normalize(text)
        if not norm:
            continue
        if norm in NEVER_MIND:
            print("Okay, never mind.")
            return 0
        code = handle(text, state)
        if code is not None:
            return code


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
