def menu_database(state):
    while True:
        library = state.library(scan_if_missing=False)
        when = f"last scanned {library['scanned_at'].replace('T', ' at ')}" if library else "not scanned yet"
        print("\nDatabase")
        print("  1) Easy commands (plain English)")
