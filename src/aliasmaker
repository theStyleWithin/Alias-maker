    def forget_pending(self):
        self.pending = None

    def update_name_hint(self):
        """Say whether the name can be typed on its own, and offer one-word versions if not."""
        phrase = self.phrase.get_text().strip()
        self.name_buttons.set_visible(False)
        if not phrase or core.match_builtin(core.normalize(phrase)):
            self.name_hint.set_visible(False)
            return
        problem = core.shell_name_problem(phrase)
        if problem is None:
            text = f"You'll be able to type it on its own: {phrase}  (or: doit {phrase})"
        elif problem[0] == "taken":
            text = (f"\"{phrase}\" is already {problem[1]}, so yours will work as "
                    f"\"doit {phrase}\" only. The real {phrase} stays exactly as it is.")
        elif problem[0] == "characters":
            text = f"This name only works with doit in front: doit {phrase}"
        else:
            text = (f"Has spaces, so it only works with doit in front: doit {phrase}. "
                    f"To also type it on its own, use one word:")
            _, short_name, full_name = core.name_suggestions(phrase)
            choices = [n for n in (short_name, full_name) if n and core.works_on_its_own(n)]
            if choices:
                self.short_button.set_label(choices[0])
                self.full_button.set_label(choices[-1])
                self.full_button.set_visible(len(choices) > 1 and choices[0] != choices[-1])
                self.name_buttons.set_visible(True)
        self.name_hint.set_label(text)
        self.name_hint.set_visible(True)

    def use_name(self, name):
        self.phrase.set_text(name)
        self.phrase.grab_focus()

    def on_example(self):
        """Fill the form from the chosen example. The user can still change anything."""
        index = self.example_picker.get_selected()
        if index == Gtk.INVALID_LIST_POSITION or index == 0:
            self.example = None
            self.example_note.set_visible(False)
            return
        example = self.examples[index - 1]
        self.example = example
        self.phrase.set_text(example["phrase"])
        self.command.set_text(example["command"])
        self.ask_first.set_active(bool(example.get("confirm")) or "sudo" in example["command"].split())
        note = example.get("explanation", "")
        if example.get("warning"):
            note += f"\nHeads up: {example['warning']}"
        self.example_note.set_label(note)
        self.example_note.set_visible(bool(note))
        self.phrase.grab_focus()  # name it whatever you like

    def on_command_changed(self):
        uses_sudo = "sudo" in self.command.get_text().split()
        if uses_sudo:
            self.ask_first.set_active(True)
        self.ask_first.set_sensitive(not uses_sudo)
        self.pending = None

    def say(self, text, kind):
        for css in ("error", "warning"):
            self.message.remove_css_class(css)
        self.message.add_css_class(kind)
        self.message.set_label(text)
        self.message.set_visible(True)

    def save(self):
        phrase = self.phrase.get_text().strip()
        command = self.command.get_text().strip()
        if not command:
            self.say("Type the command it should run.", "error")
            return
        norm = core.normalize(phrase)
        own = core.normalize(self.existing["phrase"]) if self.existing else None
        custom_map = {core.normalize(c["phrase"]): c for c in core.load_custom()}
        custom_map.pop(own, None)  # editing: the command's own phrase isn't a clash
        problem, detail = core.phrase_problem(norm, custom_map)
        if problem == "empty":
            self.say("Type the words you want to use.", "error")
            return
        if problem == "reserved":
            self.say(f"\"{phrase}\" is one of {core.APP}'s own words. Pick something else.", "error")
            return
        if problem == "custom-clash" and self.pending != (norm, command):
            self.pending = (norm, command)
            self.say(f"You already use that phrase for: {detail}\nPress Save again to replace it.",
                     "warning")
            return
        confirm = self.ask_first.get_active() or "sudo" in command.split()
        if self.existing:
            core.update_custom_command(self.existing["phrase"], phrase, command, confirm)
        else:
            # Made from an example and still running its command: keep the example's notes
            # (like the Brave installer's link), so they're shown before it runs.
            notes = (core.example_notes(self.example)
                     if self.example and command == self.example["command"] else None)
            core.save_custom_command(phrase, command, confirm, notes)
        self.close()
        self.app.custom_changed()


