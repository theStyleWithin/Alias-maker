        super().__init__(title=f"Database — {core.APP}")
        self.app = app
        self.programs = []
        self.has_manuals = True
        self.set_default_size(980, 600)
        self.set_hide_on_close(True)

        layout = padded_box()
        top = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        self.search = Gtk.SearchEntry()
        self.search.set_placeholder_text("Search by what it does: drives, wifi, battery…")
        self.search.set_hexpand(True)
        self.search.connect("search-changed", lambda *_: self.refresh())
        self.rescan_button = Gtk.Button(label="Rescan")
        self.rescan_button.set_tooltip_text("Look at what's installed again")
        self.rescan_button.connect("clicked", lambda *_: self.app.scanner.start())
        top.append(self.search)
        top.append(self.rescan_button)
        layout.append(top)
        self.status = text_label("", "dim-label")
        layout.append(self.status)

        self.stack = Gtk.Stack()
        self.stack.set_vexpand(True)
        empty = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12)
        empty.set_valign(Gtk.Align.CENTER)
        empty.set_halign(Gtk.Align.CENTER)
        empty_label = Gtk.Label(label="The database is empty.\nIt fills up after Alias Maker scans "
                                      "your installed software.")
        empty_label.set_justify(Gtk.Justification.CENTER)
        empty.append(empty_label)
        scan_now = Gtk.Button(label="Scan My Installed Software")
        scan_now.add_css_class("suggested-action")
        scan_now.connect("clicked", lambda *_: self.app.scanner.start())
        empty.append(scan_now)
        self.stack.add_named(empty, "empty")
        scanning = Gtk.Label(label="Scanning your installed software…\nThis takes a few seconds.")
        scanning.set_justify(Gtk.Justification.CENTER)
        self.stack.add_named(scanning, "scanning")
        self.stack.add_named(Gtk.Label(label="Nothing matched. Try different or fewer words."),
                             "nomatch")
        self.table = Table([  # read-only: the Database can't be edited
            Column("Command", lambda p: p["name"], 170),
            Column("What it does", lambda p: p["description"] or "(no description)"),
            Column("Package", lambda p: p.get("package") or "—", 170),
            Column("Location", lambda p: p.get("path", ""), 230),
        ], on_select=self.update_buttons, on_activate=self.make_custom)
        self.stack.add_named(self.table.scroller, "list")
        layout.append(self.stack)
        self.footer = text_label("", "dim-label")
        layout.append(self.footer)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        self.type_button = Gtk.Button(label="Type Into Terminal")
        self.type_button.connect("clicked", lambda *_: self.type_program())
        self.manual_button = Gtk.Button(label="Read Manual")
        self.manual_button.connect("clicked", lambda *_: self.read_manual())
        self.custom_button = Gtk.Button(label="Make Custom Command…")
        self.custom_button.add_css_class("suggested-action")
        self.custom_button.connect("clicked", lambda *_: self.make_custom())
        for button in (self.type_button, self.manual_button, self.custom_button):
            buttons.append(button)
        layout.append(buttons)
        self.set_child(layout)

        self.final_note = ""
        app.scanner.listeners.append(lambda: self.reload(animate=True))
        self.reload()

    def reload(self, animate=False):
        if self.app.scanner.running:
            self.stack.set_visible_child_name("scanning")
            self.status.set_label("Scanning…")
            self.footer.set_label("")
            self.rescan_button.set_sensitive(False)
            self.update_buttons()
            return
        self.rescan_button.set_sensitive(True)
        library = core.read_json(core.library_path(), None)
        if not library or not library.get("programs"):
            self.programs = []
            self.stack.set_visible_child_name("empty")
            note = f"The last scan didn't finish: {self.app.scanner.error}" if self.app.scanner.error else ""
            self.status.set_label(note)
            self.footer.set_label("")
            self.update_buttons()
            return
        self.programs = library["programs"]
        self.has_manuals = library.get("has_manuals", True)
        status = f"{len(self.programs)} programs on this PC · last scanned {scanned_when(library)}"
        if not self.has_manuals:
            status += ("\nDescriptions are thin because manual pages aren't installed. "
                       "Install them with: sudo pacman -S man-db man-pages, then Rescan.")
        self.status.set_label(status)
        self.refresh(animate)

    def refresh(self, animate=False):
        if not self.programs:
            return
        query = self.search.get_text().strip()
        if query:
            total, shown = core.search_library(self.programs, query, limit=len(self.programs))
            note = f"{total} {'match' if total == 1 else 'matches'} for \"{query}\" (best first)"
        else:
            shown = sorted(self.programs, key=lambda p: p["name"].lower())
            note = f"All {len(shown)} programs"
        self.final_note = f"{note}. Click a column title to sort by it. This list is read-only."
        self.stack.set_visible_child_name("list" if shown else "nomatch")
        self.footer.set_label("")
        self.table.set_rows(shown, animate=animate, on_progress=self.on_progress)
        self.update_buttons()

    def on_progress(self, done, total):
        if done < total:
            self.footer.set_label(f"Loading {done:,} of {total:,}…")
        else:
            self.footer.set_label(self.final_note)

    def selected(self):
        if self.stack.get_visible_child_name() != "list":
            return None
        return self.table.selected()

    def update_buttons(self):
        chosen = self.selected() is not None
        for button in (self.type_button, self.manual_button, self.custom_button):
            button.set_sensitive(chosen)

    def make_custom(self):
        program = self.selected()
        if program:
            self.app.show_create(self, command=program["name"] + " ")

    def read_manual(self):
        program = self.selected()
        if program:
            self.app.terminal().type_into_terminal(f"man {shlex.quote(program['name'])}", run=True)

    def type_program(self):
        program = self.selected()
        if program:
            self.app.terminal().type_into_terminal(program["name"] + " ")


# ---------- Custom Commands ----------

MODE_HINTS = {
    "list": "",
    "edit": "Pick the command you want to edit, then press Edit.",
    "delete": "Pick the command you want to delete, then press Delete. "
              "Only your alias is deleted, never the real command.",
}


class CustomWindow(Gtk.Window):
    """Your commands: a second database that lists only the aliases you made."""

    def __init__(self, app):
        super().__init__(title=f"Custom Commands — {core.APP}")
        self.app = app
        self.custom = []
        self.mode = "list"
        self.set_default_size(860, 480)
        self.set_hide_on_close(True)

        layout = padded_box()
        layout.append(text_label("Type these in the terminal after doit. For example, if you made "
                                 "\"just check my drives\", type: doit just check my drives"))
        layout.append(text_label("You can change any cell: click it and type. Enter or clicking "
                                 "away saves, Esc undoes.", "dim-label"))
        self.hint = text_label("", "accent")
        self.hint.set_visible(False)
        layout.append(self.hint)
        self.stack = Gtk.Stack()
        self.stack.set_vexpand(True)
        empty = Gtk.Label(label="No custom commands yet.\nPress Create Command, or pick a program in "
                                "the Database and choose Make Custom Command.")
        empty.set_justify(Gtk.Justification.CENTER)
        self.stack.add_named(empty, "empty")
        self.table = Table([  # editable, unlike the Database
            Column("You type (after doit)", lambda c: c["phrase"], 260,
                   edit="text", on_edit=lambda c, v: self.edit_cell(c, phrase=v)),
            Column("It runs", lambda c: c["command"],
                   edit="text", on_edit=lambda c, v: self.edit_cell(c, command=v)),
            Column("Asks first", lambda c: "Yes" if c.get("confirm") else "No", 110,
                   edit="check", value=lambda c: c.get("confirm"),
                   on_edit=lambda c, v: self.edit_cell(c, confirm=v)),
            Column("Made on", lambda c: c.get("added", "")[:10], 120),
        ], on_select=self.update_buttons, on_activate=self.activate_selected)
        self.stack.add_named(self.table.scroller, "list")
        layout.append(self.stack)
        self.message = text_label("")
        self.message.set_visible(False)
        layout.append(self.message)
        self.message_timer = None

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        self.delete_button = Gtk.Button(label="Delete…")
        self.delete_button.connect("clicked", lambda *_: self.delete_selected())
        self.edit_button = Gtk.Button(label="Edit…")
        self.edit_button.connect("clicked", lambda *_: self.edit_selected())
        self.run_button = Gtk.Button(label="Run in Terminal")
        self.run_button.connect("clicked", lambda *_: self.run_selected())
        create = Gtk.Button(label="Create Command…")
        create.add_css_class("suggested-action")
        create.connect("clicked", lambda *_: self.app.show_create(self))
        for button in (self.delete_button, self.edit_button, self.run_button, create):
            buttons.append(button)
        layout.append(buttons)
        self.set_child(layout)
        self.reload()

    def set_mode(self, mode):
        self.mode = mode
        hint = MODE_HINTS.get(mode, "")
        self.hint.set_label(hint)
        self.hint.set_visible(bool(hint))
        self.set_title({"edit": "Edit Command", "delete": "Delete Command"}.get(mode, "Custom Commands")
                       + f" — {core.APP}")
        for button, name in ((self.edit_button, "edit"), (self.delete_button, "delete")):
            if mode == name:
                button.add_css_class("suggested-action" if name == "edit" else "destructive-action")
            else:
                button.remove_css_class("suggested-action")
                button.remove_css_class("destructive-action")

    def reload(self, animate=False):
        self.custom = core.load_custom()
        self.stack.set_visible_child_name("list" if self.custom else "empty")
        self.table.set_rows(self.custom, animate=animate)
        self.update_buttons()
        return False  # also used as a one-off idle callback

    def say(self, text, kind):
        for css in ("error", "warning", "success"):
            self.message.remove_css_class(css)
        self.message.add_css_class(kind)
        self.message.set_label(text)
        self.message.set_visible(True)
        if self.message_timer is not None:
            GLib.source_remove(self.message_timer)

        def hide():
            self.message.set_visible(False)
            self.message_timer = None
            return False
        self.message_timer = GLib.timeout_add_seconds(8, hide)

    def edit_cell(self, custom, phrase=None, command=None, confirm=None):
        """Save one changed cell. Returns False (and explains why) to refuse the change."""
        new_phrase = custom["phrase"] if phrase is None else phrase.strip()
        new_command = custom["command"] if command is None else command.strip()
        new_confirm = bool(custom.get("confirm")) if confirm is None else bool(confirm)
        uses_sudo = "sudo" in new_command.split()

        if phrase is not None:
            norm = core.normalize(new_phrase)
            own = core.normalize(custom["phrase"])
            others = {core.normalize(c["phrase"]): c for c in core.load_custom()}
            others.pop(own, None)
            problem, detail = core.phrase_problem(norm, others, self.app.phrase_map)
            if problem == "empty":
                self.say("The phrase can't be empty, so I put the old one back.", "error")
                return False
            if problem == "reserved":
                self.say(f"\"{new_phrase}\" is one of {core.APP}'s own words, so I put the old "
                         "phrase back.", "error")
                return False
            if problem == "custom-clash":
                self.say(f"You already use \"{new_phrase}\" for: {detail}. Pick another phrase, "
                         "or delete that one first.", "error")
                return False
            if problem == "easy-clash":
                self.say(f"\"{new_phrase}\" is already an easy command (it runs: {detail}). To use "
                         "it for yours anyway, select the row and press Edit…, which asks first.",
                         "error")
                return False
        if command is not None and not new_command:
            self.say("The command can't be empty, so I put the old one back.", "error")
            return False
        if confirm is not None and not new_confirm and uses_sudo:
            self.say("Commands that use sudo always ask first, so this stays ticked.", "error")
            return False
        if uses_sudo:
            new_confirm = True

        core.update_custom_command(custom["phrase"], new_phrase, new_command, new_confirm)
        custom.update(phrase=new_phrase, command=new_command, confirm=new_confirm)
        self.say(f"Saved. \"doit {new_phrase}\" runs: {new_command}"
                 + (" (asks first)" if new_confirm else ""), "success")
        for window in self.app.terminals:
            window.refresh_menu()
        if confirm is None and uses_sudo:
            GLib.idle_add(self.reload)  # show the "Asks first" tick that sudo switched on
        return True

    def selected(self):
        return self.table.selected()

    def update_buttons(self):
        chosen = self.selected() is not None
        for button in (self.run_button, self.edit_button, self.delete_button):
            button.set_sensitive(chosen)

    def activate_selected(self):
        {"edit": self.edit_selected, "delete": self.delete_selected}.get(self.mode, self.run_selected)()

    def run_selected(self):
        custom = self.selected()
        if custom:
            self.app.terminal().type_into_terminal(f"doit {shlex.quote(custom['phrase'])}", run=True)

    def edit_selected(self):
        custom = self.selected()
        if custom:
            self.app.show_edit(self, custom)

    def delete_selected(self):
        custom = self.selected()
        if custom:
            self.app.show_delete(self, custom)


class CommandDialog(Gtk.Window):
    """Create a new command, or edit one (existing=the saved command)."""

    def __init__(self, app, parent, command="", existing=None):
        title = "Edit Command" if existing else "Create Command"
        super().__init__(title=title, transient_for=parent, modal=True)
        self.app = app
        self.existing = existing
        self.pending = None
        self.set_default_size(520, -1)

        layout = padded_box(spacing=6)
        layout.append(text_label("What do you want to type? (after doit)"))
        self.phrase = Gtk.Entry()
        self.phrase.set_placeholder_text("for example: just check my drives")
        layout.append(self.phrase)
        layout.append(text_label("What should it run?"))
        self.command = Gtk.Entry()
        self.command.set_placeholder_text("for example: lsblk -f")
        layout.append(self.command)
        if command and not existing:
            layout.append(text_label("You can add options after the program's name, like -f.",
                                     "dim-label"))
        self.ask_first = Gtk.CheckButton(label="Ask before running it every time")
        layout.append(self.ask_first)
        layout.append(text_label("This only makes a shortcut inside Alias Maker. Your computer's "
                                 "real commands stay exactly as they are.", "dim-label"))
        self.message = text_label("")
        self.message.set_visible(False)
        layout.append(self.message)

        buttons = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=8)
        buttons.set_halign(Gtk.Align.END)
        buttons.set_margin_top(6)
        cancel = Gtk.Button(label="Cancel")
        cancel.connect("clicked", lambda *_: self.close())
        save = Gtk.Button(label="Save")
        save.add_css_class("suggested-action")
        save.connect("clicked", lambda *_: self.save())
        buttons.append(cancel)
        buttons.append(save)
        layout.append(buttons)
        self.set_child(layout)

        if existing:
            self.phrase.set_text(existing["phrase"])
            self.command.set_text(existing["command"])
            self.ask_first.set_active(bool(existing.get("confirm")))
        else:
            self.command.set_text(command)
        self.command.connect("changed", lambda *_: self.on_command_changed())
        self.phrase.connect("changed", lambda *_: self.forget_pending())
        self.phrase.connect("activate", lambda *_: self.save())
        self.command.connect("activate", lambda *_: self.save())
        self.on_command_changed()
        (self.phrase if command or existing else self.command).grab_focus()

    def forget_pending(self):
        self.pending = None

    def on_command_changed(self):
        uses_sudo = "sudo" in self.command.get_text().split()
        if uses_sudo:
            self.ask_first.set_active(True)
        self.ask_first.set_sensitive(not uses_sudo)
        self.pending = None

    def say(self, text, kind):
        for css in ("error", "warning"):
            self.message.remove_css_class(css)
        self.message.add_css_class(kind)
        self.message.set_label(text)
        self.message.set_visible(True)

    def save(self):
        phrase = self.phrase.get_text().strip()
        command = self.command.get_text().strip()
        if not command:
            self.say("Type the command it should run.", "error")
            return
        norm = core.normalize(phrase)
        own = core.normalize(self.existing["phrase"]) if self.existing else None
        custom_map = {core.normalize(c["phrase"]): c for c in core.load_custom()}
        custom_map.pop(own, None)  # editing: the command's own phrase isn't a clash
        problem, detail = core.phrase_problem(norm, custom_map, self.app.phrase_map)
        if problem == "empty":
            self.say("Type the words you want to use.", "error")
            return
        if problem == "reserved":
            self.say(f"\"{phrase}\" is one of {core.APP}'s own words. Pick something else.", "error")
            return
        if problem and self.pending != (norm, command):
            self.pending = (norm, command)
            if problem == "custom-clash":
                self.say(f"You already use that phrase for: {detail}\nPress Save again to replace it.",
                         "warning")
            else:
                self.say(f"That's already an easy command (it runs: {detail}).\n"
                         "Press Save again to use it for yours instead.", "warning")
            return
        confirm = self.ask_first.get_active() or "sudo" in command.split()
        if self.existing:
            core.update_custom_command(self.existing["phrase"], phrase, command, confirm)
        else:
            core.save_custom_command(phrase, command, confirm)
        self.close()
        self.app.custom_changed()


class DeleteDialog(Gtk.Window):
