class AliasMakerApp(Gtk.Application):
    def __init__(self, workdir, command):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.workdir = workdir
        self.command = command
        self.scanner = Scanner()
        self.terminals = []
        self.last_terminal = None
        self.database_window = None
        self.custom_window = None
        self.settings_window = None
        self.log_window = None
        self.examples = core.load_examples()  # starting points for Create Command

    def do_activate(self):
        core.migrate_old_dirs()
        install_table_style()
        core.write_fish_shortcuts()  # make sure the real terminal commands match the saved ones
        self.new_window(self.workdir, self.command)
        if core.library_outdated():
            self.scanner.start()  # first run, or software was installed or removed since the scan

    def new_window(self, workdir=None, command=None):
        crash.note("terminal window opened")
        window = TerminalWindow(self, workdir, command)
        self.terminals.append(window)
        self.last_terminal = window
        window.present()
        return window

    def terminal(self):
        """The terminal window to type into: the last one used, or a new one."""
        if self.last_terminal in self.terminals:
            return self.last_terminal
        if self.terminals:
            return self.terminals[-1]
        return self.new_window()

    def terminal_closed(self, window):
        if window in self.terminals:
            self.terminals.remove(window)
        if not self.terminals:
            self.quit()  # the Database and Custom Commands windows close with the last terminal

    def show_database(self, parent):
        """Opens the Database in its own window and builds the table up gradually."""
        if self.database_window is None:
            self.database_window = DatabaseWindow(self)
        window = self.database_window
        already_open = window.get_visible()
        window.present()
        if not already_open:
            window.reload(animate=True)
            if core.library_path().is_file() and core.library_outdated():
                self.scanner.start()  # something was installed or removed: refresh the list

    def show_custom(self, parent, mode="list"):
        if self.custom_window is None:
            self.custom_window = CustomWindow(self)
        window = self.custom_window
        already_open = window.get_visible()
        window.set_mode(mode)
        window.present()
        window.reload(animate=not already_open)  # builds up gradually when it opens

    def show_settings(self, parent):
        if self.settings_window is None:
            self.settings_window = SettingsWindow(self)
        self.settings_window.reload()
        self.settings_window.present()

    def show_log(self, parent):
        """Opens the Command Log in its own window and builds the table up gradually."""
        if self.log_window is None:
            self.log_window = LogWindow(self)
        window = self.log_window
        already_open = window.get_visible()
        window.present()
        window.reload(animate=not already_open)

    def show_create(self, parent, command=""):
        CommandDialog(self, parent, command=command).present()

    def show_edit(self, parent, custom):
        CommandDialog(self, parent, existing=custom).present()

    def show_delete(self, parent, custom):
        DeleteDialog(self, parent, custom).present()

    def custom_changed(self, open_list=True):
        """After a create, edit or delete: refresh every menu and the list."""
        for window in self.terminals:
            window.refresh_menu()
        if open_list:
            self.show_custom(self.terminal(), "list")
        elif self.custom_window is not None:
            self.custom_window.reload()


def name_process():
    """Call this process "aliasmaker" instead of "python3" (in btop, htop, ps and the like)."""
    try:
        import ctypes
        libc = ctypes.CDLL(None)
        libc.prctl(15, ctypes.c_char_p(core.TERMINAL_COMMAND.encode()), 0, 0, 0)  # PR_SET_NAME
    except (OSError, AttributeError):
        pass


def main(argv):
    NEW_CRASHES.extend(crash.install("window", sudden_crashes=True))
    crash.note("Alias Maker opened")
    name_process()
    workdir, command = parse_args(argv)
    app = AliasMakerApp(workdir, command)
    return app.run([sys.argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
