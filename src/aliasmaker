# ---------- small helpers ----------

def user_shell():
    """The user's login shell, the same one Konsole would start."""
    candidates = []
    try:
        candidates.append(pwd.getpwuid(os.getuid()).pw_shell)
    except KeyError:
        pass
    candidates += [os.environ.get("SHELL", ""), "/bin/bash", "/bin/sh"]
    for shell in candidates:
        if shell and os.access(shell, os.X_OK):
            return shell
    return "/bin/sh"


def parse_args(argv):
    """Understands the options desktops pass to a default terminal: --workdir and -e."""
    workdir, command = None, None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if arg == "--version":
            print(f"{core.APP} {core.VERSION}")
            sys.exit(0)
        if arg in ("-e", "-x", "--command", "--"):
            command = argv[i + 1:] or None
            break
        if arg in ("--workdir", "--working-directory", "-w") and i + 1 < len(argv):
            workdir = argv[i + 1]
            i += 2
            continue
        if arg.startswith(("--workdir=", "--working-directory=")):
            workdir = arg.split("=", 1)[1]
        i += 1
    return workdir, command


def labeled_button(icon, text, tooltip=None):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    box.append(Gtk.Image.new_from_icon_name(icon))
    box.append(Gtk.Label(label=text))
    button = Gtk.Button()
    button.set_child(box)
    if tooltip:
        button.set_tooltip_text(tooltip)
    return button


def padded_box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12):
    box = Gtk.Box(orientation=orientation, spacing=spacing)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(margin)
    return box


def text_label(text, css=None, wrap=True):
    label = Gtk.Label(label=text, xalign=0)
    label.set_wrap(wrap)
    if css:
        label.add_css_class(css)
    return label


class Row(GObject.Object):
    """One line of a table. Holds the program or custom command it shows."""
    __gtype_name__ = "AliasMakerRow"

    def __init__(self, data):
        super().__init__()
        self.data = data


def compare(a, b):
    return (a > b) - (a < b)


def animations_enabled():
    """False if the user turned animations off in their desktop settings."""
    settings = Gtk.Settings.get_default()
    if settings is None:
        return True
    try:
        return bool(settings.get_property("gtk-enable-animations"))
    except TypeError:
        return True


FILL_SECONDS = 1.2  # how long the gradual build-up takes, whatever the number of rows


class Column:
    """One table column.

    text(data) gives the cell text, also used for sorting. width is a starting width in
    pixels, or None for the column that fills the rest. edit is None (read-only), "text"
    (click the cell and type) or "check" (a checkbox; value(data) gives its state).
    on_edit(data, new_value) saves a change and returns False to refuse it.
    """

    def __init__(self, title, text, width=None, edit=None, on_edit=None, value=None):
        self.title, self.text, self.width = title, text, width
        self.edit, self.on_edit, self.value = edit, on_edit, value


class Table:
    """A spreadsheet-style table: grid lines, bold headers, sortable columns, equal rows.

    Every column can be resized, and clicking a title sorts by it. Rows can fill in
    gradually (set_rows with animate=True). Cells are read-only unless their column says
    otherwise.
    """

    def __init__(self, columns, on_select, on_activate):
        self.store = Gio.ListStore.new(Row)
        self.pending = []
        self.fill_source = None
        self.view = Gtk.ColumnView()
        self.view.set_show_row_separators(True)
        self.view.set_show_column_separators(True)
        self.view.add_css_class("aliasmaker-table")
        self.view.add_css_class("data-table")
        for spec in columns:
            factory = Gtk.SignalListItemFactory()
            factory.connect("setup", self._setup, spec)
            factory.connect("bind", self._bind, spec)
            column = Gtk.ColumnViewColumn.new(spec.title, factory)
            column.set_resizable(True)
            if spec.width:
                column.set_fixed_width(spec.width)
            else:
                column.set_expand(True)
            column.set_sorter(self._sorter(spec.text))
            self.view.append_column(column)
        self.sorted = Gtk.SortListModel.new(self.store, self.view.get_sorter())
        self.selection = Gtk.SingleSelection.new(self.sorted)
        self.selection.set_autoselect(False)
        self.selection.set_can_unselect(True)
        self.selection.connect("notify::selected", lambda *_: on_select())
        self.view.set_model(self.selection)
        self.view.connect("activate", lambda *_: on_activate())
        self.scroller = Gtk.ScrolledWindow()
        self.scroller.set_vexpand(True)
        self.scroller.set_child(self.view)

    @staticmethod
    def _sorter(text):
        def sort(a, b, *_):
            return compare(text(a.data).lower(), text(b.data).lower())
        try:
            return Gtk.CustomSorter.new(sort)
        except TypeError:
            return Gtk.CustomSorter.new(sort, None)

    # --- cells ---

    def _setup(self, _factory, cell, spec):
        if spec.edit == "text":
            widget = Gtk.Entry()  # looks like a plain cell; click into it to type, like a spreadsheet
            widget.set_has_frame(False)
            widget.set_hexpand(True)
            widget.connect("activate", lambda entry: self._commit_text(entry, spec))
            focus = Gtk.EventControllerFocus()
            focus.connect("enter", lambda *_: self._select_cell(widget))
            focus.connect("leave", lambda *_: self._commit_text(widget, spec))
            widget.add_controller(focus)
            keys = Gtk.EventControllerKey()
            keys.connect("key-pressed", lambda _c, keyval, *_: self._escape(widget, keyval))
            widget.add_controller(keys)
        elif spec.edit == "check":
            widget = Gtk.CheckButton()
            widget.set_halign(Gtk.Align.CENTER)
            widget.connect("toggled", lambda button: self._commit_check(button, spec))
        else:
            widget = Gtk.Label(xalign=0)
            widget.set_ellipsize(Pango.EllipsizeMode.END)  # long text ends in "…" so rows stay even
            widget.set_single_line_mode(True)
        widget.cell = cell
        widget.binding = False
        cell.set_child(widget)

    @staticmethod
    def _bind(_factory, cell, spec):
        data = cell.get_item().data
        widget = cell.get_child()
        widget.data = data
        widget.binding = True
        text = spec.text(data)
        if spec.edit == "check":
            widget.set_active(bool(spec.value(data)))
        else:
            widget.set_text(text)
            widget.original = text
        widget.set_tooltip_text(text if len(text) > 30 else None)  # hover shows the whole thing
        widget.binding = False

    def _select_cell(self, widget):
        position = widget.cell.get_position()
        if position != Gtk.INVALID_LIST_POSITION:
            self.selection.set_selected(position)

    @staticmethod
    def _escape(entry, keyval):
        if keyval == Gdk.KEY_Escape:
            entry.set_text(entry.original)  # undo what was typed
            return True
        return False

    @staticmethod
    def _commit_text(entry, spec):
        if entry.binding or not hasattr(entry, "data"):
            return
        new = entry.get_text().strip()
        if new == entry.original:
            return
        if spec.on_edit(entry.data, new) is False:
            entry.set_text(entry.original)  # refused: put the old value back
        else:
            entry.original = new

    @staticmethod
    def _commit_check(button, spec):
        if button.binding or not hasattr(button, "data"):
            return
        active = button.get_active()
        if spec.on_edit(button.data, active) is False:
            button.binding = True
            button.set_active(not active)
            button.binding = False

    # --- rows ---

    def set_rows(self, rows, animate=False, on_progress=None):
        """Show these rows. With animate=True they fill in gradually instead of all at once."""
        self.stop_filling()
        self.selection.set_selected(Gtk.INVALID_LIST_POSITION)
        self.store.remove_all()
        items = [Row(data) for data in rows]
        if not animate or not items or not animations_enabled():
            self.store.splice(0, 0, items)
            if on_progress:
                on_progress(len(items), len(items))
            return
        total_ms = int(FILL_SECONDS * 1000)
        interval = max(30, min(90, total_ms // len(items)))  # a few rows: one at a time
        batch = max(1, -(-len(items) * interval // total_ms))  # many rows: a batch per step
        self.pending = items
        self.fill_source = GLib.timeout_add(interval, self._fill_step, batch, len(items), on_progress)

    def _fill_step(self, batch, total, on_progress):
        chunk, self.pending = self.pending[:batch], self.pending[batch:]
        self.store.splice(self.store.get_n_items(), 0, chunk)
        if on_progress:
            on_progress(self.store.get_n_items(), total)
        if self.pending:
            return True
        self.fill_source = None
        return False

    def stop_filling(self):
        if self.fill_source is not None:
            GLib.source_remove(self.fill_source)
            self.fill_source = None
        self.pending = []

    def filling(self):
        return self.fill_source is not None

    def count(self):
        return self.store.get_n_items()

    def selected(self):
        item = self.selection.get_selected_item()
        return item.data if item is not None else None


def install_table_style():
    provider = Gtk.CssProvider()
    try:
        provider.load_from_string(TABLE_CSS)
    except AttributeError:  # GTK older than 4.12
        provider.load_from_data(TABLE_CSS.encode())
    display = Gdk.Display.get_default()
    if display is not None:
        Gtk.StyleContext.add_provider_for_display(display, provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)


def scanned_when(library):
    return library.get("scanned_at", "").replace("T", " at ")


# ---------- scanning in the background ----------

class Scanner:
    """Runs the scan off the main thread so the window never freezes."""

    def __init__(self):
        self.running = False
        self.error = None
        self.listeners = []

    def start(self):
        if self.running:
            return
        self.running = True
        self.error = None
        self.notify()
        threading.Thread(target=self._work, daemon=True).start()

    def _work(self):
        error = None
        try:
            core.scan_library()
        except Exception as err:  # keep the window alive whatever happens
            error = str(err)
        GLib.idle_add(self._finished, error)

    def _finished(self, error):
        self.running = False
        self.error = error
        self.notify()
        return False

    def notify(self):
        for listener in list(self.listeners):
            listener()


# ---------- the terminal window ----------

class TerminalWindow(Gtk.ApplicationWindow):
    def __init__(self, app, workdir=None, command=None):
        super().__init__(application=app, title=core.APP)
        self.app = app
        self.set_default_size(960, 580)
        self.set_icon_name("utilities-terminal")

        self.term = Vte.Terminal()
        self.term.set_scrollback_lines(10000)
        self.term.set_hexpand(True)
        self.term.set_vexpand(True)
        self.set_child(self.term)

        self.title_label = Gtk.Label(label=core.APP)
        self.title_label.add_css_class("title")
        self.subtitle_label = Gtk.Label()
        self.subtitle_label.add_css_class("dim-label")
        self.subtitle_label.set_visible(False)
        title_box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        title_box.set_valign(Gtk.Align.CENTER)
        title_box.append(self.title_label)
        title_box.append(self.subtitle_label)

        header = Gtk.HeaderBar()
        header.set_title_widget(title_box)
        self.menu_button = Gtk.MenuButton()
        self.menu_button.set_icon_name("open-menu-symbolic")
        self.menu_button.set_tooltip_text("Menu")
        self.menu_button.set_menu_model(self.build_menu())
        try:
            # Rebuild the menu each time it opens, so it's right even after `doit add` in the shell.
            self.menu_button.set_create_popup_func(lambda button, *_: self.refresh_menu())
        except (AttributeError, TypeError):
            pass  # the menu is still refreshed whenever a command is created, edited or deleted
        header.pack_end(self.menu_button)
        paste = labeled_button("edit-paste-symbolic", "Paste", "Paste (Ctrl+Shift+V)")
        paste.connect("clicked", lambda *_: self.paste())
        copy = labeled_button("edit-copy-symbolic", "Copy", "Copy (Ctrl+Shift+C)")
        copy.connect("clicked", lambda *_: self.copy())
        header.pack_end(paste)
        header.pack_end(copy)
        self.set_titlebar(header)

        self.add_window_actions()
        keys = Gtk.EventControllerKey()
        keys.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)
        keys.connect("key-pressed", self.on_key)
        self.add_controller(keys)

        self.term.connect("child-exited", lambda *_: self.close())
        try:
            self.term.connect("window-title-changed", self.on_title_changed)
        except TypeError:
            pass  # newer VTE versions dropped this signal; the title just stays "Alias Maker"
        self.connect("notify::is-active", self.on_active_changed)
        self.connect("close-request", self.on_close_request)

        app.scanner.listeners.append(self.on_scan_changed)
        self.on_scan_changed()
        self.spawn(workdir, command)
        self.term.grab_focus()

    def build_menu(self):
        menu = Gio.Menu()
        ours = Gio.Menu()
        ours.append("Database", "win.database")
        if core.load_custom():  # only once the user has made their first command
            custom = Gio.Menu()
            custom.append("Custom Command List", "win.custom-list")
            custom.append("Create Command", "win.create-command")
            custom.append("Edit Command", "win.edit-command")
            custom.append("Delete Command", "win.delete-command")
            ours.append_submenu("Custom Commands", custom)
        ours.append("Create Command", "win.create-command")
        menu.append_section(None, ours)
        sections = [
            [("New Window", "win.new-window", "<Control><Shift>n"),
             ("Copy", "win.copy", "<Control><Shift>c"),
             ("Paste", "win.paste", "<Control><Shift>v")],
            [("Full Screen Mode", "win.fullscreen", "F11"),
             ("Enlarge Font", "win.zoom-in", "<Control>plus"),
             ("Reset Font Size", "win.zoom-reset", "<Control><Alt>0"),
             ("Shrink Font", "win.zoom-out", "<Control>minus")],
            [("About Alias Maker", "win.about", None)],
        ]
        for entries in sections:
            section = Gio.Menu()
            for label, action, accel in entries:
                item = Gio.MenuItem.new(label, action)
                if accel:
                    item.set_attribute_value("accel", GLib.Variant("s", accel))
                section.append_item(item)
            menu.append_section(None, section)
        return menu

    def refresh_menu(self):
        self.menu_button.set_menu_model(self.build_menu())

    def add_window_actions(self):
        actions = {
            "database": lambda: self.app.show_database(self),
            "custom-list": lambda: self.app.show_custom(self, "list"),
            "create-command": lambda: self.app.show_create(self),
            "edit-command": lambda: self.app.show_custom(self, "edit"),
            "delete-command": lambda: self.app.show_custom(self, "delete"),
            "new-window": self.app.new_window,
            "copy": self.copy,
            "paste": self.paste,
            "fullscreen": self.toggle_fullscreen,
            "zoom-in": lambda: self.zoom(1.1),
            "zoom-out": lambda: self.zoom(1 / 1.1),
            "zoom-reset": lambda: self.zoom(None),
            "about": self.show_about,
        }
        for name, callback in actions.items():
            action = Gio.SimpleAction.new(name, None)
            action.connect("activate", lambda _a, _p, cb=callback: cb())
            self.add_action(action)

    # --- the shell inside ---

    def spawn(self, workdir, command):
        shell = user_shell()
        if command and len(command) == 1 and " " in command[0]:
            argv = [shell, "-c", command[0]]
        else:
            argv = command or [shell]
        env = dict(os.environ)
        env["PATH"] = SRC_DIR + os.pathsep + env.get("PATH", "")  # doit always works in here
        env["ALIASMAKER"] = "1"
        envv = [f"{key}={value}" for key, value in env.items()]
        cwd = workdir if workdir and os.path.isdir(workdir) else os.path.expanduser("~")
        args = [Vte.PtyFlags.DEFAULT, cwd, argv, envv, GLib.SpawnFlags.SEARCH_PATH,
                None, None, -1, None, None, None]
        try:
            self.term.spawn_async(*args)
        except TypeError:
            del args[6]  # older PyGObject: no separate child-setup data argument
            self.term.spawn_async(*args)

    def type_into_terminal(self, text, run=False):
        """Put text at the prompt. With run=True, clear the line first and press Enter."""
        data = (("\x15" + text + "\n") if run else text).encode()
        try:
            self.term.feed_child(data)
        except TypeError:
            self.term.feed_child(data.decode(), len(data))
        self.present()
        self.term.grab_focus()

    # --- menu actions ---

    def copy(self):
        self.term.copy_clipboard_format(Vte.Format.TEXT)

    def paste(self):
        self.term.paste_clipboard()

    def toggle_fullscreen(self):
        if self.is_fullscreen():
            self.unfullscreen()
        else:
            self.fullscreen()

    def zoom(self, factor):
        scale = 1.0 if factor is None else self.term.get_font_scale() * factor
        self.term.set_font_scale(max(0.4, min(scale, 4.0)))

    def show_about(self):
        about = Gtk.AboutDialog(transient_for=self, modal=True)
        about.set_program_name(core.APP)
        about.set_version(core.VERSION)
        about.set_comments("A terminal that makes Linux commands easier: a database of the "
                           "programs on your PC, and your own custom commands.")
        about.set_license_type(Gtk.License.APACHE_2_0)
        about.set_logo_icon_name("utilities-terminal")
        about.present()

    def on_key(self, _controller, keyval, _keycode, state):
        mods = state & Gtk.accelerator_get_default_mod_mask()
        control = Gdk.ModifierType.CONTROL_MASK
        shift = Gdk.ModifierType.SHIFT_MASK
        alt = Gdk.ModifierType.ALT_MASK
        name = Gdk.keyval_name(Gdk.keyval_to_lower(keyval)) or ""
        if keyval == Gdk.KEY_F11 and not mods:
            self.toggle_fullscreen()
            return True
        if mods == control | shift and name in ("c", "v", "n"):
            {"c": self.copy, "v": self.paste, "n": self.app.new_window}[name]()
            return True
        if mods & control and not mods & alt:
            if name in ("plus", "equal", "kp_add"):
                self.zoom(1.1)
                return True
            if name in ("minus", "underscore", "kp_subtract"):
                self.zoom(1 / 1.1)
                return True
        if mods == control | alt and name in ("0", "kp_0"):
            self.zoom(None)
            return True
        return False

    # --- window state ---

    def on_title_changed(self, *_):
        try:
            title = self.term.get_window_title()
        except (AttributeError, TypeError):
            title = None
        self.title_label.set_label(title or core.APP)
        self.set_title(f"{title} — {core.APP}" if title else core.APP)

    def on_active_changed(self, *_):
        if self.is_active():
            self.app.last_terminal = self

    def on_scan_changed(self):
        scanner = self.app.scanner
        if scanner.running:
            self.show_subtitle("Scanning your installed software for the Database…")
        elif scanner.error:
            self.show_subtitle("The scan didn't finish. Try Rescan in the Database.", seconds=8)
        elif self.subtitle_label.get_visible():
            library = core.read_json(core.library_path(), None) or {}
            count = len(library.get("programs", []))
            self.show_subtitle(f"Database ready: {count} programs", seconds=5)

    def show_subtitle(self, text, seconds=None):
        self.subtitle_label.set_label(text)
        self.subtitle_label.set_visible(True)
        if seconds:
            def hide():
                if not self.app.scanner.running:
                    self.subtitle_label.set_visible(False)
                return False
            GLib.timeout_add_seconds(seconds, hide)

    def on_close_request(self, *_):
        if self.on_scan_changed in self.app.scanner.listeners:
            self.app.scanner.listeners.remove(self.on_scan_changed)
        self.app.terminal_closed(self)
        return False


