def user_shell():
    """The shell to start: the user's login shell, the same one Konsole would start.

    From the AppImage, a login shell that isn't fish gets the AppImage's own fish instead, so
    the Let'sdostuff~ prompt, /clippy and one-word commands work on any PC (bash on SteamOS and
    Ubuntu). ALIASMAKER_SHELL=/path/to/shell picks a different one.
    """
    chosen = os.environ.get("ALIASMAKER_SHELL", "")
    if chosen and os.access(chosen, os.X_OK):
        return chosen
    candidates = []
    try:
        candidates.append(pwd.getpwuid(os.getuid()).pw_shell)
    except KeyError:
        pass
    candidates += [os.environ.get("SHELL", ""), "/bin/bash", "/bin/sh"]
    shell = next((s for s in candidates if s and os.access(s, os.X_OK)), "/bin/sh")
    bundled = os.environ.get("ALIASMAKER_BUNDLED_FISH", "")
    if bundled and os.access(bundled, os.X_OK) and os.path.basename(shell) != "fish":
        return bundled
    return shell


def fish_quote(text):
    """Quote text for fish: single quotes, with backslashes and quotes escaped."""
    return "'" + text.replace("\\", "\\\\").replace("'", "\\'") + "'"


def shell_argv(shell):
    """How to start the shell. Fish gets the Let'sdostuff~ title and prompt; others start as-is."""
    if os.path.basename(shell) == "fish" and os.path.isfile(FISH_TITLE_SCRIPT):
        return [shell, "--init-command", f"source {fish_quote(FISH_TITLE_SCRIPT)}"]
    return [shell]


def parse_args(argv):
    """Understands the options desktops pass to a default terminal: --workdir and -e."""
    workdir, command = None, None
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg in ("-h", "--help"):
            print(__doc__.strip())
            sys.exit(0)
        if arg == "--version":
            print(f"{core.APP} {core.VERSION}")
            sys.exit(0)
        if arg in ("-e", "-x", "--command", "--"):
            command = argv[i + 1:] or None
            break
        if arg in ("--workdir", "--working-directory", "-w") and i + 1 < len(argv):
            workdir = argv[i + 1]
            i += 2
            continue
        if arg.startswith(("--workdir=", "--working-directory=")):
            workdir = arg.split("=", 1)[1]
        i += 1
    return workdir, command


def labeled_button(icon, text, tooltip=None):
    box = Gtk.Box(orientation=Gtk.Orientation.HORIZONTAL, spacing=6)
    box.append(Gtk.Image.new_from_icon_name(icon))
    box.append(Gtk.Label(label=text))
    button = Gtk.Button()
    button.set_child(box)
    if tooltip:
        button.set_tooltip_text(tooltip)
    return button


def padded_box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin=12):
    box = Gtk.Box(orientation=orientation, spacing=spacing)
    for side in ("top", "bottom", "start", "end"):
        getattr(box, f"set_margin_{side}")(margin)
    return box


def text_label(text, css=None, wrap=True):
    label = Gtk.Label(label=text, xalign=0)
    label.set_wrap(wrap)
    if css:
        label.add_css_class(css)
    return label


