    def set_mode(self, mode):
        self.mode = mode
        hint = MODE_HINTS.get(mode, "")
        self.hint.set_label(hint)
        self.hint.set_visible(bool(hint))
        self.set_title({"edit": "Edit Command", "delete": "Delete Command"}.get(mode, "Custom Commands")
                       + f" — {core.APP}")
        for button, name in ((self.edit_button, "edit"), (self.delete_button, "delete")):
            if mode == name:
                button.add_css_class("suggested-action" if name == "edit" else "destructive-action")
            else:
                button.remove_css_class("suggested-action")
                button.remove_css_class("destructive-action")

    def reload(self, animate=False):
        self.custom = core.load_custom()
        self.stack.set_visible_child_name("list" if self.custom else "empty")
        self.table.set_rows(self.custom, animate=animate)
        self.update_buttons()
        return False  # also used as a one-off idle callback

    def say(self, text, kind):
        for css in ("error", "warning", "success"):
            self.message.remove_css_class(css)
        self.message.add_css_class(kind)
        self.message.set_label(text)
        self.message.set_visible(True)
        if self.message_timer is not None:
            GLib.source_remove(self.message_timer)

        def hide():
            self.message.set_visible(False)
            self.message_timer = None
            return False
        self.message_timer = GLib.timeout_add_seconds(8, hide)

    def edit_cell(self, custom, phrase=None, command=None, confirm=None):
        """Save one changed cell. Returns False (and explains why) to refuse the change."""
        new_phrase = custom["phrase"] if phrase is None else phrase.strip()
        new_command = custom["command"] if command is None else command.strip()
        new_confirm = bool(custom.get("confirm")) if confirm is None else bool(confirm)
        uses_sudo = "sudo" in new_command.split()

        if phrase is not None:
            norm = core.normalize(new_phrase)
            own = core.normalize(custom["phrase"])
            others = {core.normalize(c["phrase"]): c for c in core.load_custom()}
            others.pop(own, None)
            problem, detail = core.phrase_problem(norm, others)
            if problem == "empty":
                self.say("The phrase can't be empty, so I put the old one back.", "error")
                return False
            if problem == "reserved":
                self.say(f"\"{new_phrase}\" is one of {core.APP}'s own words, so I put the old "
                         "phrase back.", "error")
                return False
            if problem == "custom-clash":
                self.say(f"You already use \"{new_phrase}\" for: {detail}. Pick another phrase, "
                         "or delete that one first.", "error")
                return False
        if command is not None and not new_command:
            self.say("The command can't be empty, so I put the old one back.", "error")
            return False
        if confirm is not None and not new_confirm and uses_sudo:
            self.say("Commands that use sudo always ask first, so this stays ticked.", "error")
            return False
        if uses_sudo:
            new_confirm = True

        core.update_custom_command(custom["phrase"], new_phrase, new_command, new_confirm)
        custom.update(phrase=new_phrase, command=new_command, confirm=new_confirm)
        self.say(f"Saved. \"doit {new_phrase}\" runs: {new_command}"
                 + (" (asks first)" if new_confirm else ""), "success")
        for window in self.app.terminals:
            window.refresh_menu()
        if confirm is None and uses_sudo:
            GLib.idle_add(self.reload)  # show the "Asks first" tick that sudo switched on
        return True

    def selected(self):
        return self.table.selected()

    def update_buttons(self):
        chosen = self.selected() is not None
        for button in (self.run_button, self.edit_button, self.delete_button):
            button.set_sensitive(chosen)

    def activate_selected(self):
        {"edit": self.edit_selected, "delete": self.delete_selected}.get(self.mode, self.run_selected)()

    def run_selected(self):
        custom = self.selected()
        if custom:
            self.app.terminal().type_into_terminal(f"doit {shlex.quote(custom['phrase'])}", run=True)

    def edit_selected(self):
        custom = self.selected()
        if custom:
            self.app.show_edit(self, custom)

    def delete_selected(self):
        custom = self.selected()
        if custom:
            self.app.show_delete(self, custom)


