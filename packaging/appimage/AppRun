#!/bin/bash
# Starts Alias Maker from the AppImage, using the Python, GTK 4 and VTE inside it:
# nothing has to be installed, and nothing is asked. There are no pop-ups here by design.
#   ./Alias-Maker-x86_64.AppImage              the terminal window
#   ./Alias-Maker-x86_64.AppImage doit ...     the doit command (one-word commands use this)
#   ./Alias-Maker-x86_64.AppImage debug ...    Alias Maker Debug
here="${0%/*}"
usr="$here/usr"
app="$usr/lib/alias-maker/src"
prog=@DEFAULT@

case "$1" in
    doit) shift; prog=doit ;;
    debug | aliasmaker-debug) shift; prog=aliasmaker-debug ;;
    aliasmaker) shift; prog=aliasmaker ;;
    python) shift; prog=python ;;   # for debugging: the AppImage's own Python, set up like the app's
esac

# For the window: a doit that works without Python on the PC. The shell is the PC's own.
export ALIASMAKER_DOIT_DIR="$usr/lib/alias-maker/bin"

# doit needs none of GTK's settings (and passes its environment on to your own commands)
if [ "$prog" = doit ]; then
    exec "$usr/bin/python3" -s "$app/doit" "$@"
fi

# The window gives the shell inside it back what these were before (see crash.bundle_env_fixes),
# so programs you start from the terminal never see the AppImage's own settings.
keep() {
    if [ -n "${!1+x}" ]; then
        export "ALIASMAKER_ORIG_$1=${!1}"
        unset "ALIASMAKER_WAS_UNSET_$1"
    else
        unset "ALIASMAKER_ORIG_$1"
        export "ALIASMAKER_WAS_UNSET_$1=1"
    fi
}
for name in GI_TYPELIB_PATH GDK_PIXBUF_MODULE_FILE GSETTINGS_SCHEMA_DIR GIO_MODULE_DIR XDG_DATA_DIRS; do
    keep "$name"
done

export GI_TYPELIB_PATH="$usr/lib/girepository-1.0"
# GTK finds its image loaders (the SVG icons) through a list that needs this run's real path.
# One small file, rewritten each time, in the per-user runtime folder.
cache_dir="${XDG_RUNTIME_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}}/alias-maker"
[ -d "$cache_dir" ] || mkdir -p "$cache_dir" 2>/dev/null
sed "s|@APPDIR@|$here|g" "$usr/lib/gdk-pixbuf-2.0/loaders.cache.in" > "$cache_dir/pixbuf-loaders.cache" 2>/dev/null &&
    export GDK_PIXBUF_MODULE_FILE="$cache_dir/pixbuf-loaders.cache"
export GSETTINGS_SCHEMA_DIR="$usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$usr/lib/gio-modules"
export XDG_DATA_DIRS="$usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

if [ "$prog" = python ]; then
    exec "$usr/bin/python3" -s "$@"
fi
exec "$usr/bin/python3" -s "$app/$prog" "$@"
