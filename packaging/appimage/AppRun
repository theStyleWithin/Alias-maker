#!/bin/sh
# Starts Alias Maker from the AppImage, using the Python, GTK 4, VTE and fish inside it:
# nothing has to be installed, and nothing is asked. There are no pop-ups here by design.
#   ./Alias-Maker-x86_64.AppImage              the terminal window
#   ./Alias-Maker-x86_64.AppImage doit ...     the doit command (one-word commands use this)
#   ./Alias-Maker-x86_64.AppImage debug ...    Alias Maker Debug
here="$(dirname "$(readlink -f "$0")")"
usr="$here/usr"
app="$usr/lib/alias-maker/src"
prog=@DEFAULT@

case "$1" in
    doit) shift; prog=doit ;;
    debug | aliasmaker-debug) shift; prog=aliasmaker-debug ;;
    aliasmaker) shift; prog=aliasmaker ;;
esac

# The window gives the shell inside it back what these were before (see crash.bundle_env_fixes),
# so programs you start from the terminal never see the AppImage's own settings.
keep() {
    if [ -n "$(eval "echo \${$1+x}")" ]; then
        eval "export ALIASMAKER_ORIG_$1=\"\$$1\""
        unset "ALIASMAKER_WAS_UNSET_$1"
    else
        unset "ALIASMAKER_ORIG_$1"
        export "ALIASMAKER_WAS_UNSET_$1=1"
    fi
}
for name in GI_TYPELIB_PATH GDK_PIXBUF_MODULEDIR GDK_PIXBUF_MODULE_FILE GSETTINGS_SCHEMA_DIR \
            GIO_MODULE_DIR XDG_DATA_DIRS SSL_CERT_FILE PYTHONNOUSERSITE; do
    keep "$name"
done

export PYTHONNOUSERSITE=1
export GI_TYPELIB_PATH="$usr/lib/girepository-1.0"
export GDK_PIXBUF_MODULEDIR="$usr/lib/gdk-pixbuf-2.0/loaders"
export GDK_PIXBUF_MODULE_FILE="$usr/lib/gdk-pixbuf-2.0/loaders.cache"
export GSETTINGS_SCHEMA_DIR="$usr/share/glib-2.0/schemas"
export GIO_MODULE_DIR="$usr/lib/gio-modules"
export XDG_DATA_DIRS="$usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Python doesn't know where this PC keeps its trusted certificates (for /clippy's wiki lookups)
if [ -z "$SSL_CERT_FILE" ]; then
    for file in /etc/ssl/certs/ca-certificates.crt /etc/pki/tls/certs/ca-bundle.crt \
                /etc/ssl/ca-bundle.pem /etc/ssl/cert.pem; do
        [ -r "$file" ] && { export SSL_CERT_FILE="$file"; break; }
    done
fi

# For the window: its own fish, and a doit that works without Python on the PC
export ALIASMAKER_BUNDLED_FISH="$usr/bin/fish"
export ALIASMAKER_DOIT_DIR="$usr/lib/alias-maker/bin"

exec "$usr/bin/python3" "$app/$prog" "$@"
